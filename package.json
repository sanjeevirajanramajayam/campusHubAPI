{
  "name": "campushub-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CampusHub Full-Stack Decoupled Monorepo (Express 5 + Next.js 16)",
  "scripts": {
    "dev": "pnpm --parallel run dev",
    "dev:backend": "pnpm --filter backend run dev",
    "dev:frontend": "pnpm --filter frontend run dev",
    "build": "pnpm --recursive run build",
    "build:backend": "pnpm --filter backend run build",
    "build:frontend": "pnpm --filter frontend run build",
    "test": "pnpm --filter backend run test",
    "test:unit": "pnpm --filter backend run test:unit",
    "test:integration": "pnpm --filter backend run test:integration",
    "test:concurrency": "pnpm --filter backend run test:concurrency",
    "test:security": "pnpm --filter backend run test:security",
    "test:coverage": "pnpm --filter backend run test:coverage",
    "lint": "pnpm --recursive run lint",
    "format": "pnpm --filter backend run format",
    "format:check": "pnpm --filter backend run format:check",
    "typecheck": "pnpm --filter backend run typecheck",
    "prisma:generate": "pnpm --filter backend run prisma:generate",
    "prisma:migrate": "pnpm --filter backend run prisma:migrate"
  }
}
