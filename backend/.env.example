# ==========================================
# CampusHub Environment Configuration Template
# ==========================================

# Application
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/campushub_dev?schema=public

# Redis (Caching & Queues: Use REDIS_URL or REDIS_HOST/PORT)
REDIS_URL=rediss://default:password@xxxx.upstash.io:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication Secrets
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_minimum_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_minimum_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
